# Free paper account: https://app.alpaca.markets/signup
# Keys under: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Free key: https://finnhub.io/register (optional -- adds a second news
# source for cross-confirmation; the bot runs fine without it)
FINNHUB_API_KEY=

# Discord Developer Portal application/bot token, and the channel ID to post into
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Local Ollama (must already be running: `ollama serve`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral-nemo:latest

# Comma-separated tickers to watch. Keep this small -- each symbol is a
# live websocket subscription plus a rolling in-memory price buffer.
WATCHLIST=SPY,QQQ,NVDA,AAPL,MSFT,TSLA
