# Proposed selector change for #225 G3a (Brian, 2026-11-11).
#
# Applies at 16a4494d on brian/225-deployment-boundaries, and is rebound on the
# packaging and staging rules in Musef's bff49eed tree (origin/musef/225-assets-preview).
#
# deploy.yml gains frontend/**, scripts/build-assets.mjs and wrangler.assets.toml:
# the two packaged gateway files, the packager that assembles artifact bytes, and
# the applied asset configuration that decides how they are served.
#
# web-ci.yml gains frontend/**, wrangler.assets.toml, wrangler.api.toml, the
# labelled fallback template patches/musef-225/wrangler.assets.toml.proposed, and
# the three scripts build-assets, prepare-asset-release and preview-local. Those
# are inputs to the artifact, to the staged plan or to the preview evidence; none
# of them is a promotion trigger except the packager and the applied asset config
# listed above.
#
# This matches Musef's patches/musef-225/web-ci-only.patch on the overlapping
# filter lines, so Nova can consolidate the two hunks without choosing between
# them. The deploy-side material here is separate and not part of that patch.
#
# Nothing here touches a backend/** path, adds a second promotion lane, or
# changes provider topology: splitting the two workflows is Nova's step after
# P2/P3. It also does not sequence build -> verify -> deploy of a staged
# payload/, which is G3b work.
#
# Apply with: git apply patches/brian-225/deploy-selectors.patch
diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
index 9b2fecdd..d8ed41b8 100644
--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -5,8 +5,11 @@ on:
     branches: [master]
     paths:
       - "site/**"
+      - "frontend/**"
       - "backend/**"
       - "wrangler.toml"
+      - "wrangler.assets.toml"
+      - "scripts/build-assets.mjs"
       - "scripts/stamp-build.mjs"
       - "tests/build_stamp.test.mjs"
       - ".github/workflows/deploy.yml"
diff --git a/.github/workflows/web-ci.yml b/.github/workflows/web-ci.yml
index 08f55804..f469cf58 100644
--- a/.github/workflows/web-ci.yml
+++ b/.github/workflows/web-ci.yml
@@ -9,8 +9,15 @@ on:
     paths:
       - "backend/**"
       - "site/**"
+      - "frontend/**"
       - "tests/**"
       - "wrangler.toml"
+      - "wrangler.assets.toml"
+      - "wrangler.api.toml"
+      - "patches/musef-225/wrangler.assets.toml.proposed"
+      - "scripts/build-assets.mjs"
+      - "scripts/prepare-asset-release.mjs"
+      - "scripts/preview-local.mjs"
       - "scripts/stamp-build.mjs"
       - "scripts/generate-quote-instruments.mjs"
       - ".github/workflows/deploy.yml"
@@ -20,8 +27,15 @@ on:
     paths:
       - "backend/**"
       - "site/**"
+      - "frontend/**"
       - "tests/**"
       - "wrangler.toml"
+      - "wrangler.assets.toml"
+      - "wrangler.api.toml"
+      - "patches/musef-225/wrangler.assets.toml.proposed"
+      - "scripts/build-assets.mjs"
+      - "scripts/prepare-asset-release.mjs"
+      - "scripts/preview-local.mjs"
       - "scripts/stamp-build.mjs"
       - "scripts/generate-quote-instruments.mjs"
       - ".github/workflows/deploy.yml"
